#!/bin/sh
set -eu
out=/run/robot-metrics
mkdir -p "$out"
file="$out/arranque.txt"
# Resultado por boot; reiniciar manualmente la unidad invalida esta medicion.
if [ -e "$file" ]; then
    echo "Ya existe $file; no se reemplaza la medicion del arranque actual."
    exit 0
fi
started=$(awk '{print $1}' /proc/uptime)
i=0
while [ "$i" -lt 120 ]; do
    # WGET retorna error ante HTTP no exitoso; la respuesta debe ser status=ok.
    if body=$(busybox wget -q -T 1 -O - http://127.0.0.1:8080/api/status 2>/dev/null); then
        if printf '%s\n' "$body" | grep -q '"status"[[:space:]]*:[[:space:]]*"ok"'; then
            ready=$(awk '{print $1}' /proc/uptime)
            {
                echo "boot_id=$(cat /proc/sys/kernel/random/boot_id)"
                echo "api_operativa_desde_inicio_kernel_s=$ready"
                echo "sondeo_iniciado_desde_kernel_s=$started"
                echo 'metodo=primera respuesta HTTP exitosa con status=ok en localhost:8080/api/status'
                echo 'limite=excluye firmware y bootloader; sondeo cada 1 s mas duracion de peticion'
                systemctl show robot.service -p NRestarts -p ActiveState -p SubState
            } > "$file"
            echo "RumBa metricas: API operativa a los $ready s desde inicio del kernel."
            exit 0
        fi
    fi
    sleep 1
    i=$((i+1))
done
echo 'No se detecto API disponible tras 120 intentos; revisar journal de robot.service.' >&2
exit 1
