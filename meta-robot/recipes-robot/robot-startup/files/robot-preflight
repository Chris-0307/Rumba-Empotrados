#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
fail() { echo "RumBa preflight: $*" >&2; exit 1; }
[ -x /home/root/robot_server ] || fail "Falta /home/root/robot_server"
[ -x /usr/libexec/robot/robot-hw-check ] || fail "Falta robot-hw-check"
[ -r /usr/lib/librobot.so.1 ] || fail "Falta librobot.so.1"
# No depende de Internet: asociacion (carrier) y direccion IPv4 local.
tries=0
until [ "$(cat /sys/class/net/wlan0/carrier 2>/dev/null || true)" = 1 ] &&
    ip -4 -o addr show dev wlan0 scope global 2>/dev/null | grep -q 'inet '; do
    tries=$((tries+1))
    [ "$tries" -lt 30 ] || fail "Wi-Fi sin IPv4 local despues de 30 intentos"
    sleep 1
 done
tries=0
until [ -c /dev/gpiochip0 ] && [ -r /sys/class/pwm/pwmchip0/npwm ] &&
    [ "$(cat /sys/class/pwm/pwmchip0/npwm)" -ge 2 ] &&
    amixer -c Device scontrols >/dev/null 2>&1; do
    tries=$((tries+1))
    [ "$tries" -lt 30 ] || fail "Falta GPIO, dos canales PWM o tarjeta USB Device"
    sleep 1
 done
[ -x /usr/bin/aplay ] || fail "Falta aplay"
[ -x /usr/bin/mpg123 ] || fail "Falta mpg123"
for sound in inicio manual automatico obstaculo fin_ciclo; do
    [ -r "${ROBOT_ALERTS_DIR:-/usr/share/robot/sounds}/$sound.wav" ] || fail "Falta $sound.wav"
done
# Volumen de hardware: independiente del slider del reproductor web.
amixer -c Device sset Speaker 100% unmute >/dev/null || fail "No se pudo ajustar volumen USB"
# Prueba real por librobot: no usa GPIO/PWM desde el servidor ni ordena avanzar.
/usr/libexec/robot/robot-hw-check || fail "librobot no pudo inicializar o apagar hardware"
echo "RumBa preflight: Wi-Fi, GPIO, PWM y audio listos; iniciando en manual"
